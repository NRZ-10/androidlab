<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/etDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Here"
        android:textSize="26sp"
        android:inputType="none"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <!-- Number Buttons -->
        <GridLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:columnCount="3">

            <Button android:id="@+id/b1" android:text="1"/>
            <Button android:id="@+id/b2" android:text="2"/>
            <Button android:id="@+id/b3" android:text="3"/>

            <Button android:id="@+id/b4" android:text="4"/>
            <Button android:id="@+id/b5" android:text="5"/>
            <Button android:id="@+id/b6" android:text="6"/>

            <Button android:id="@+id/b7" android:text="7"/>
            <Button android:id="@+id/b8" android:text="8"/>
            <Button android:id="@+id/b9" android:text="9"/>

            <Button android:id="@+id/bDot" android:text="."/>
            <Button android:id="@+id/b0" android:text="0"/>
            <Button android:id="@+id/bClear" android:text="C"/>
        </GridLayout>

        <!-- Operator Buttons -->
        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="20dp">

            <Button
                android:id="@+id/bAdd"
                android:text="+"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/bSub"
                android:text="-"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/bMul"
                android:text="X"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/bDiv"
                android:text="/"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/bEqual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="="
        android:layout_marginTop="25dp"/>

</LinearLayout>
